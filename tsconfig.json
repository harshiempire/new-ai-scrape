{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES6",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist", // This is where compiled .js files will go
    "rootDir": "./src", // This is where your TypeScript files are located
    "resolveJsonModule": true,
    "strictNullChecks": true
  },
  "include": [
    "src/**/*.ts", // Includes all files in src folder
    "src/routes/auth/index.ts"
  ],
  "exclude": [
    "node_modules" // Exclude node_modules
  ]
}
