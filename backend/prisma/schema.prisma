// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workflow {
  id         String      @id @default(uuid())
  name       String
  nodes      Json // Storing nodes as JSON
  edges      Json // Storing edges as JSON
  executions Execution[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("workflows")
}

model Execution {
  id            String         @id @default(uuid())
  workflowId    String
  runNumber     Int            @default(1)
  workflow      Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status        String
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  executionTime Float? // in milliseconds
  executionData ExecutionData?

  @@index([workflowId])
  @@index([status])
  @@map("executions")
}

model ExecutionData {
  id            String    @id @default(uuid())
  executionId   String    @unique
  execution     Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  variablePool  Json // Storing variable pool as JSON
  initialInputs Json // Storing initial inputs as JSON

  @@map("execution_data")
}

model Nodes {
  id               String   @id @default(uuid())
  type             NodeType
  propertiesSchema Json

  @@map("nodes")
}

enum NodeType {
  ACTION
  TRIGGER
  CONDITION
}

model Edges {
  id     String @id @default(uuid())
  source String
  target String
  data   Json // Storing edge data as JSON

  @@map("edges")
}
